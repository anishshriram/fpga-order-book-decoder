// tangnano20k.cst -- physical constraints for the Sipeed Tang Nano 20K
// (Gowin GW2AR-18 QN88). Synthesis fails without pin assignments.
//
// Onboard pins (fixed, from the Sipeed board files):
//   clk    27 MHz crystal      pin 4
//   rst_n  button S1           pin 88   (pressed = 0; top.v inverts)
//   led    6 LEDs, ACTIVE LOW  pins 15..20
//
// 7-seg (uxcell 5641BH, common anode) is wired by hand to free header pins on
// J5. Segment order matches display.v: seg[0]=a .. seg[6]=g, seg[7]=dp.
// dig[d] HIGH enables digit d; seg[k] LOW lights a segment.
//
// HARDWARE: the common anode sources the sum of all lit segment currents
// (up to ~48 mA) -- past a single GW2A pin. Drive dig[] through PNP / P-MOSFET
// high-side switches, not straight from the FPGA. ~220 ohm in each seg line.

IO_LOC  "clk" 4;
IO_PORT "clk" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "rst_n" 88;
IO_PORT "rst_n" IO_TYPE=LVCMOS33 PULL_MODE=UP;

IO_LOC  "led[0]" 15;
IO_LOC  "led[1]" 16;
IO_LOC  "led[2]" 17;
IO_LOC  "led[3]" 18;
IO_LOC  "led[4]" 19;
IO_LOC  "led[5]" 20;
IO_PORT "led[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led[5]" IO_TYPE=LVCMOS33 DRIVE=8;

// ---- 7-segment: segments a..g,dp  (J5 header) ----
IO_LOC  "seg[0]" 75;    // a   J5 pin 4
IO_LOC  "seg[1]" 42;    // b   J5 pin 6
IO_LOC  "seg[2]" 41;    // c   J5 pin 7
IO_LOC  "seg[3]" 56;    // d   J5 pin 8
IO_LOC  "seg[4]" 54;    // e   J5 pin 9
IO_LOC  "seg[5]" 51;    // f   J5 pin 10
IO_LOC  "seg[6]" 48;    // g   J5 pin 11
IO_LOC  "seg[7]" 55;    // dp  J5 pin 12
IO_PORT "seg[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "seg[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "seg[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "seg[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "seg[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "seg[5]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "seg[6]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "seg[7]" IO_TYPE=LVCMOS33 DRIVE=8;

// ---- 7-segment: digit anode enables (through high-side switches) ----
// dig[0..3]  = display 1 digits 1..4    (single-book: the only display)
// dig[4..7]  = display 2 digits 1..4    (-DSSEG3 only)
// dig[8..11] = display 3 digits 1..4    (-DSSEG3 only; shares pins with dbg[])
IO_LOC  "dig[0]" 49;    // J5 pin 13
IO_LOC  "dig[1]" 86;    // J5 pin 14
IO_LOC  "dig[2]" 72;    // J5 pin 18
IO_LOC  "dig[3]" 71;    // J5 pin 19
IO_LOC  "dig[4]" 73;
IO_LOC  "dig[5]" 74;
IO_LOC  "dig[6]" 76;
IO_LOC  "dig[7]" 77;
IO_LOC  "dig[8]"  27;
IO_LOC  "dig[9]"  28;
IO_LOC  "dig[10]" 29;
IO_LOC  "dig[11]" 30;
IO_PORT "dig[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dig[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dig[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dig[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dig[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dig[5]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dig[6]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dig[7]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dig[8]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dig[9]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dig[10]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dig[11]" IO_TYPE=LVCMOS33 DRIVE=8;

// ---- UART readout: FPGA TX -> onboard FT2232 channel B -> host ----
// Appears on the host as the second /dev/cu.usbserial-* port. No wiring.
IO_LOC  "uart_tx" 69;
IO_PORT "uart_tx" IO_TYPE=LVCMOS33 DRIVE=8 PULL_MODE=UP;

// ---- logic-analyzer taps on the J6 header ----
//   dbg0 byte_valid  dbg1 event_valid  dbg2 book_busy  dbg3 done
//   dbg4 uart_tx     dbg5 best_bid[0]  dbg6 best_bid[8] dbg7 best_bid[16]
IO_LOC  "dbg[0]" 73;
IO_LOC  "dbg[1]" 74;
IO_LOC  "dbg[2]" 76;
IO_LOC  "dbg[3]" 77;
IO_LOC  "dbg[4]" 27;
IO_LOC  "dbg[5]" 28;
IO_LOC  "dbg[6]" 29;
IO_LOC  "dbg[7]" 30;
IO_PORT "dbg[0]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg[1]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg[2]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg[3]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg[4]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg[5]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg[6]" IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "dbg[7]" IO_TYPE=LVCMOS33 DRIVE=8;
